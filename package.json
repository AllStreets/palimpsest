{
  "name": "palimpsest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --no-warnings --import tsx --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p app",
    "engine": "tsx engine/main.ts",
    "dev": "concurrently -k \"tsx watch engine/main.ts\" \"vite\"",
    "build": "vite build",
    "ui-test": "node --no-warnings --import tsx tools/ui-test.ts",
    "perf": "node --no-warnings --import tsx tools/perf.ts",
    "sample": "node --no-warnings --import tsx tools/sample-run.ts",
    "diagrams": "node --no-warnings --import tsx tools/diagrams.ts",
    "film": "node --no-warnings --import tsx tools/film.ts",
    "media:check": "node --no-warnings --import tsx tools/media-check.ts",
    "install:check": "node --no-warnings --import tsx tools/install-check.ts",
    "app": "vite build && tauri build",
    "trainer:setup": "uv venv --python cpython-3.12-macos-aarch64-none trainer/.venv && uv pip install --python trainer/.venv/bin/python -r trainer/requirements.txt && trainer/.venv/bin/python -c \"import platform, sys; sys.exit(0 if platform.machine() == 'arm64' else 'the trainer is not arm64')\"",
    "test:trainer": "node --no-warnings --import tsx tools/test-trainer.ts"
  },
  "dependencies": {
    "beagle": "https://codeload.github.com/AllStreets/beagle/tar.gz/d72c872ec704565da88e8cf792af1b06a23fd285",
    "three": "^0.187.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "concurrently": "^10.0.7",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
